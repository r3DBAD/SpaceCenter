digraph idef1x {
 graph [rankdir=TB fontname="Arial" nodesep=0.6 ranksep=0.9 splines=true pad=0.3 bgcolor=white];
 node [fontname="Arial" fontsize=10];
 edge [fontname="Arial" fontsize=9 dir=both arrowtail=none arrowhead=dot arrowsize=0.8];
 SPACEPORT [shape=plain label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT"><B>SPACEPORT</B></TD></TR><TR><TD><TABLE BORDER="1.5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#dcebff"><TR><TD ALIGN="LEFT" BALIGN="LEFT">spaceport_id: INTEGER (PK)<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">code: TEXT (AK1)<BR ALIGN="LEFT"/>name: TEXT<BR ALIGN="LEFT"/>region: TEXT<BR ALIGN="LEFT"/></TD></TR></TABLE></TD></TR></TABLE>>];
 STAFF [shape=plain label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT"><B>STAFF</B></TD></TR><TR><TD><TABLE BORDER="1.5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#fff3cc"><TR><TD ALIGN="LEFT" BALIGN="LEFT">staff_id: INTEGER (PK)<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">login: TEXT (AK1)<BR ALIGN="LEFT"/>full_name: TEXT<BR ALIGN="LEFT"/>role: TEXT<BR ALIGN="LEFT"/>password_hash: TEXT<BR ALIGN="LEFT"/>password_salt: TEXT<BR ALIGN="LEFT"/>is_active: INTEGER<BR ALIGN="LEFT"/>spaceport_id: INTEGER (FK, NULL)<BR ALIGN="LEFT"/></TD></TR></TABLE></TD></TR></TABLE>>];
 VEHICLE_TYPE [shape=plain label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT"><B>VEHICLE_TYPE</B></TD></TR><TR><TD><TABLE BORDER="1.5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white"><TR><TD ALIGN="LEFT" BALIGN="LEFT">vehicle_type_id: INTEGER (PK)<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">name: TEXT (AK1)<BR ALIGN="LEFT"/>vehicle_class: TEXT<BR ALIGN="LEFT"/>stages_count: INTEGER<BR ALIGN="LEFT"/></TD></TR></TABLE></TD></TR></TABLE>>];
 LAUNCH_PAD [shape=plain label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT"><B>LAUNCH_PAD</B></TD></TR><TR><TD><TABLE BORDER="1.5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#fff3cc"><TR><TD ALIGN="LEFT" BALIGN="LEFT">pad_id: INTEGER (PK)<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">spaceport_id: INTEGER (FK)<BR ALIGN="LEFT"/>code: TEXT (AK1)<BR ALIGN="LEFT"/>name: TEXT<BR ALIGN="LEFT"/>max_concurrent: INTEGER<BR ALIGN="LEFT"/>cycle_limit: INTEGER<BR ALIGN="LEFT"/>hours_limit: REAL<BR ALIGN="LEFT"/>is_faulty: INTEGER<BR ALIGN="LEFT"/></TD></TR></TABLE></TD></TR></TABLE>>];
 LAUNCH [shape=plain label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT"><B>LAUNCH</B></TD></TR><TR><TD><TABLE BORDER="1.5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white"><TR><TD ALIGN="LEFT" BALIGN="LEFT">launch_id: INTEGER (PK)<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">vehicle_type_id: INTEGER (FK)<BR ALIGN="LEFT"/>pad_id: INTEGER (FK)<BR ALIGN="LEFT"/>created_by: INTEGER (FK)<BR ALIGN="LEFT"/>payload: TEXT<BR ALIGN="LEFT"/>target_orbit: TEXT<BR ALIGN="LEFT"/>window_start: TEXT<BR ALIGN="LEFT"/>window_end: TEXT<BR ALIGN="LEFT"/>status: TEXT<BR ALIGN="LEFT"/>pad_hours: REAL<BR ALIGN="LEFT"/>cancel_reason: TEXT<BR ALIGN="LEFT"/></TD></TR></TABLE></TD></TR></TABLE>>];
 STAGE_LOG [shape=plain label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT"><B>STAGE_LOG</B></TD></TR><TR><TD><TABLE BORDER="1.5" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white"><TR><TD ALIGN="LEFT" BALIGN="LEFT">launch_id: INTEGER (PK,FK)<BR ALIGN="LEFT"/>seq_no: INTEGER (PK)<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">status: TEXT<BR ALIGN="LEFT"/>changed_at: TEXT<BR ALIGN="LEFT"/>staff_id: INTEGER (FK)<BR ALIGN="LEFT"/></TD></TR></TABLE></TD></TR></TABLE>>];
 PAD_MAINTENANCE [shape=plain label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT"><B>PAD_MAINTENANCE</B></TD></TR><TR><TD><TABLE BORDER="1.5" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white"><TR><TD ALIGN="LEFT" BALIGN="LEFT">pad_id: INTEGER (PK,FK)<BR ALIGN="LEFT"/>maint_no: INTEGER (PK)<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">kind: TEXT<BR ALIGN="LEFT"/>opened_at: TEXT<BR ALIGN="LEFT"/>closed_at: TEXT<BR ALIGN="LEFT"/>notes: TEXT<BR ALIGN="LEFT"/>staff_id: INTEGER (FK)<BR ALIGN="LEFT"/></TD></TR></TABLE></TD></TR></TABLE>>];
 FUEL_BATCH [shape=plain label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT"><B>FUEL_BATCH</B></TD></TR><TR><TD><TABLE BORDER="1.5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#fff3cc"><TR><TD ALIGN="LEFT" BALIGN="LEFT">batch_id: INTEGER (PK)<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">spaceport_id: INTEGER (FK)<BR ALIGN="LEFT"/>batch_no: TEXT (AK1)<BR ALIGN="LEFT"/>component: TEXT<BR ALIGN="LEFT"/>grade: TEXT<BR ALIGN="LEFT"/>initial_mass_hg: INTEGER<BR ALIGN="LEFT"/>produced_on: TEXT<BR ALIGN="LEFT"/>expires_on: TEXT<BR ALIGN="LEFT"/></TD></TR></TABLE></TD></TR></TABLE>>];
 FUEL_CONSUMPTION [shape=plain label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT"><B>FUEL_CONSUMPTION</B></TD></TR><TR><TD><TABLE BORDER="1.5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#fff3cc"><TR><TD ALIGN="LEFT" BALIGN="LEFT">consumption_id: INTEGER (PK)<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">launch_id: INTEGER (FK)<BR ALIGN="LEFT"/>batch_id: INTEGER (FK)<BR ALIGN="LEFT"/>mass_hg: INTEGER<BR ALIGN="LEFT"/>consumed_at: TEXT<BR ALIGN="LEFT"/>staff_id: INTEGER (FK)<BR ALIGN="LEFT"/></TD></TR></TABLE></TD></TR></TABLE>>];
 WEATHER_OBSERVATION [shape=plain label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT"><B>WEATHER_OBSERVATION</B></TD></TR><TR><TD><TABLE BORDER="1.5" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white"><TR><TD ALIGN="LEFT" BALIGN="LEFT">launch_id: INTEGER (PK,FK)<BR ALIGN="LEFT"/>obs_no: INTEGER (PK)<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">observed_at: TEXT<BR ALIGN="LEFT"/>ground_wind: REAL<BR ALIGN="LEFT"/>altitude_wind: REAL<BR ALIGN="LEFT"/>temperature: REAL<BR ALIGN="LEFT"/>cloud_base: REAL<BR ALIGN="LEFT"/>thunderstorm: INTEGER<BR ALIGN="LEFT"/>staff_id: INTEGER (FK)<BR ALIGN="LEFT"/></TD></TR></TABLE></TD></TR></TABLE>>];
 TELEMETRY_CHANNEL [shape=plain label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT"><B>TELEMETRY_CHANNEL</B></TD></TR><TR><TD><TABLE BORDER="1.5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white"><TR><TD ALIGN="LEFT" BALIGN="LEFT">channel_id: INTEGER (PK)<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">channel_no: TEXT (AK1)<BR ALIGN="LEFT"/>vehicle_system: TEXT<BR ALIGN="LEFT"/>parameter: TEXT<BR ALIGN="LEFT"/>frequency_hz: REAL<BR ALIGN="LEFT"/></TD></TR></TABLE></TD></TR></TABLE>>];
 INCIDENT [shape=plain label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT"><B>INCIDENT</B></TD></TR><TR><TD><TABLE BORDER="1.5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white"><TR><TD ALIGN="LEFT" BALIGN="LEFT">incident_id: INTEGER (PK)<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">launch_id: INTEGER (FK)<BR ALIGN="LEFT"/>channel_id: INTEGER (FK)<BR ALIGN="LEFT"/>occurred_at: TEXT<BR ALIGN="LEFT"/>description: TEXT<BR ALIGN="LEFT"/>measures: TEXT<BR ALIGN="LEFT"/>staff_id: INTEGER (FK)<BR ALIGN="LEFT"/></TD></TR></TABLE></TD></TR></TABLE>>];
 POSTPONEMENT [shape=plain label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT"><B>POSTPONEMENT</B></TD></TR><TR><TD><TABLE BORDER="1.5" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#fff3cc"><TR><TD ALIGN="LEFT" BALIGN="LEFT">launch_id: INTEGER (PK,FK)<BR ALIGN="LEFT"/>postpone_no: INTEGER (PK)<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">reason: TEXT (weather|technical|organizational)<BR ALIGN="LEFT"/>old_start: TEXT<BR ALIGN="LEFT"/>old_end: TEXT<BR ALIGN="LEFT"/>new_start: TEXT<BR ALIGN="LEFT"/>new_end: TEXT<BR ALIGN="LEFT"/>comment: TEXT<BR ALIGN="LEFT"/>recorded_at: TEXT<BR ALIGN="LEFT"/>staff_id: INTEGER (FK)<BR ALIGN="LEFT"/></TD></TR></TABLE></TD></TR></TABLE>>];
 WEATHER_FORECAST [shape=plain label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT"><B>WEATHER_FORECAST</B></TD></TR><TR><TD><TABLE BORDER="1.5" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#dcebff"><TR><TD ALIGN="LEFT" BALIGN="LEFT">launch_id: INTEGER (PK,FK)<BR ALIGN="LEFT"/>forecast_no: INTEGER (PK)<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">window_start: TEXT<BR ALIGN="LEFT"/>requested_at: TEXT<BR ALIGN="LEFT"/>source: TEXT<BR ALIGN="LEFT"/>status: TEXT<BR ALIGN="LEFT"/>valid_at: TEXT<BR ALIGN="LEFT"/>ground_wind: REAL<BR ALIGN="LEFT"/>altitude_wind: REAL<BR ALIGN="LEFT"/>temperature: REAL<BR ALIGN="LEFT"/>cloud_base: REAL<BR ALIGN="LEFT"/>thunderstorm: INTEGER<BR ALIGN="LEFT"/>details: TEXT<BR ALIGN="LEFT"/>staff_id: INTEGER (FK, NULL)<BR ALIGN="LEFT"/></TD></TR></TABLE></TD></TR></TABLE>>];
 AUDIT_LOG [shape=plain label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT"><B>AUDIT_LOG</B></TD></TR><TR><TD><TABLE BORDER="1.5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#dcebff"><TR><TD ALIGN="LEFT" BALIGN="LEFT">audit_id: INTEGER (PK)<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">recorded_at: TEXT<BR ALIGN="LEFT"/>staff_id: INTEGER (FK)<BR ALIGN="LEFT"/>role: TEXT<BR ALIGN="LEFT"/>action: TEXT<BR ALIGN="LEFT"/>object_type: TEXT<BR ALIGN="LEFT"/>object_ref: TEXT<BR ALIGN="LEFT"/>outcome: TEXT<BR ALIGN="LEFT"/>details: TEXT<BR ALIGN="LEFT"/></TD></TR></TABLE></TD></TR></TABLE>>];
 VEHICLE_CHANNEL [shape=plain label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT"><B>VEHICLE_CHANNEL</B> (проект, Т2)</TD></TR><TR><TD><TABLE BORDER="1.5" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#eeeeee"><TR><TD ALIGN="LEFT" BALIGN="LEFT">vehicle_type_id: INTEGER (PK,FK)<BR ALIGN="LEFT"/>channel_id: INTEGER (PK,FK)<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"></TD></TR></TABLE></TD></TR></TABLE>>];
 CHANNEL_MODE_RATE [shape=plain label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT"><B>CHANNEL_MODE_RATE</B> (проект, Т2)</TD></TR><TR><TD><TABLE BORDER="1.5" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#eeeeee"><TR><TD ALIGN="LEFT" BALIGN="LEFT">vehicle_type_id: INTEGER (PK,FK)<BR ALIGN="LEFT"/>channel_id: INTEGER (PK,FK)<BR ALIGN="LEFT"/>mode: TEXT (PK)<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">frequency_hz: REAL<BR ALIGN="LEFT"/></TD></TR></TABLE></TD></TR></TABLE>>];
 VEHICLE_TYPE -> LAUNCH [style=dashed arrowtail=none label="используется в"];
 LAUNCH_PAD -> LAUNCH [style=dashed arrowtail=none label="назначена для"];
 STAFF -> LAUNCH [style=dashed arrowtail=none label="регистрирует"];
 LAUNCH -> STAGE_LOG [style=solid arrowtail=none label="проходит" headlabel="P"];
 STAFF -> STAGE_LOG [style=dashed arrowtail=none label="отмечает"];
 LAUNCH_PAD -> PAD_MAINTENANCE [style=solid arrowtail=none label="обслуживается"];
 LAUNCH -> FUEL_CONSUMPTION [style=dashed arrowtail=none label="заправляется"];
 FUEL_BATCH -> FUEL_CONSUMPTION [style=dashed arrowtail=none label="расходуется"];
 LAUNCH -> WEATHER_OBSERVATION [style=solid arrowtail=none label="обеспечивается"];
 LAUNCH -> POSTPONEMENT [style=solid arrowtail=none label="переносится"];
 LAUNCH -> INCIDENT [style=dashed arrowtail=none label="сопровождается"];
 TELEMETRY_CHANNEL -> INCIDENT [style=dashed arrowtail=odiamond label="фиксирует потерю"];
 SPACEPORT -> LAUNCH_PAD [style=dashed arrowtail=none label="располагает"];
 SPACEPORT -> FUEL_BATCH [style=dashed arrowtail=none label="хранит"];
 SPACEPORT -> STAFF [style=dashed arrowtail=odiamond label="закрепляет"];
 LAUNCH -> WEATHER_FORECAST [style=solid arrowtail=none label="получает прогноз"];
 STAFF -> WEATHER_FORECAST [style=dashed arrowtail=odiamond label="вводит вручную"];
 STAFF -> AUDIT_LOG [style=dashed arrowtail=none label="совершает действие"];
 VEHICLE_TYPE -> VEHICLE_CHANNEL [style=solid arrowtail=none label="конфигурирует" color="#999999" fontcolor="#777777"];
 TELEMETRY_CHANNEL -> VEHICLE_CHANNEL [style=solid arrowtail=none label="входит в" color="#999999" fontcolor="#777777"];
 VEHICLE_CHANNEL -> CHANNEL_MODE_RATE [style=solid arrowtail=none label="опрашивается в режиме" headlabel="P" color="#999999" fontcolor="#777777"];
 {rank=same; STAFF; VEHICLE_TYPE; LAUNCH_PAD; FUEL_BATCH; TELEMETRY_CHANNEL}
 {rank=same; STAGE_LOG; WEATHER_OBSERVATION; POSTPONEMENT; FUEL_CONSUMPTION; INCIDENT; PAD_MAINTENANCE}
 {rank=same; WEATHER_FORECAST; AUDIT_LOG; CHANNEL_MODE_RATE}
 legend [shape=plain label=<<TABLE BORDER="0" CELLSPACING="4"><TR><TD BGCOLOR="#dcebff" BORDER="1">новая</TD><TD BGCOLOR="#fff3cc" BORDER="1">изменена</TD><TD BGCOLOR="#eeeeee" BORDER="1">проект Т2</TD></TR></TABLE>>];
}