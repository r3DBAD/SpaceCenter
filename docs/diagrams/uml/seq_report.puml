@startuml seq_report
' Сценарий S6 «Формирование отчёта»
skinparam DefaultFontName Arial
skinparam DefaultFontSize 12
skinparam BackgroundColor white
skinparam shadowing false
autonumber

actor "Руководитель\nцентра" as U
boundary ":Vue (app.js)" as V <<View>>
control ":WebApi" as C <<Controller>>
participant ":ReportService" as S <<Model>>
participant "report:FuelUsageReport" as R <<Model>>
database ":FuelRepository" as FR <<Model/DAO>>
participant "CsvExporter" as X <<View>>

U -> V : вкладка «Отчёты»: «Расход топлива по партиям»,\nс 01.09.2026 по 30.09.2026, «Сформировать»
V -> C : GET /api/reports/fuel?from=…&to=…
C -> S : build(session, "fuel",\nPeriod(date_from, date_to))
activate S
S -> S : session.require(VIEW_REPORTS)
note right of S : Period.__post_init__:\nначало ≤ конец, ≤ 10 лет
S -> R ** : REPORTS["fuel"](repos, now)
S -> R : build(period)
activate R
R -> FR : batch_usage(start, end)\n(SELECT … SUM(volume) … GROUP BY batch,\nпараметры через «?»)
FR --> R : строки
R -> R : вычисление остатка и % использования\n(остаток не хранится — вычисляется)
R --> S : ReportTable(title, columns, rows, totals)
deactivate R
S --> C : ReportTable
deactivate S
C --> V : 200 {title, columns, rows, notes}
V -> U : таблица отчёта
opt экспорт
  U -> V : «CSV»
  V -> C : GET /api/reports/fuel.csv?from=…&to=…
  C -> S : build(...)
  C -> X : to_text(report)
  X --> C : CSV (с защитой от формул)
  C --> V : файл (Content-Disposition: attachment)
  V -> U : скачивание файла
end
@enduml
