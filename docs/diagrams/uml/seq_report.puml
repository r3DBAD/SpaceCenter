@startuml seq_report
' Сценарий S6 «Формирование отчёта»
skinparam DefaultFontName Arial
skinparam DefaultFontSize 12
skinparam BackgroundColor white
skinparam shadowing false
autonumber

actor "Руководитель\nцентра" as U
boundary ":ConsoleView" as V <<View>>
control ":ReportController" as C <<Controller>>
participant ":ReportService" as S <<Model>>
participant "report:FuelUsageReport" as R <<Model>>
database ":FuelRepository" as FR <<Model/DAO>>
participant ":CsvExporter" as X <<View>>

U -> V : «Отчёты» → «Расход топлива по партиям»
V -> C : on_report(kind="fuel")
C -> V : ask_period()
U -> V : с 01.09.2026 по 30.09.2026
V --> C : Period(date_from, date_to)
C -> S : build(session, "fuel", period)
activate S
S -> S : session.require(VIEW_REPORTS)
S -> S : period.validate() (с ≤ по)
S -> R ** : REPORTS["fuel"](repositories)
S -> R : build(period)
activate R
R -> FR : batch_usage(period)\n(SELECT … SUM(volume) … GROUP BY batch)
FR --> R : строки
R -> R : вычисление остатка и % использования\n(остаток не хранится — вычисляется)
R --> S : ReportTable(title, columns, rows, totals)
deactivate R
S --> C : ReportTable
deactivate S
C -> V : show_table(report)
V -> U : таблица в консоли
opt экспорт
  U -> V : «Сохранить в CSV»
  V -> C : on_export()
  C -> X : export(report, path)
  X --> C : путь к файлу
  C -> V : show_message("Сохранено: …")
end
@enduml
