@startuml seq_register_launch
' Сценарий S2 «Регистрация пуска»
skinparam DefaultFontName Arial
skinparam DefaultFontSize 12
skinparam BackgroundColor white
skinparam shadowing false
skinparam sequenceMessageAlign center
autonumber

actor "Руководитель\nцентра" as U
boundary ":Vue (app.js)" as V <<View>>
control ":WebApi" as C <<Controller>>
participant ":LaunchService" as S <<Model>>
participant ":Session" as Ses <<Model>>
entity "launch:Launch" as L <<Model>>
database ":LaunchPadRepository" as PR <<Model/DAO>>
database ":LaunchRepository" as LR <<Model/DAO>>

U -> V : вкладка «Новый пуск»
V -> C : GET /api/reference
C --> V : типы РН, площадки (JSON)
V -> U : форма (тип РН, ПН, орбита,\nплощадка, начало/конец окна)
U -> V : ввод данных, «Зарегистрировать»
V -> C : POST /api/launches (JSON)
C -> C : _session(token);\n_parse_dt(window_start / end)

C -> S : register_launch(session, vehicle_type_id,\npad_id, payload, orbit, start, end)
activate S
S -> Ses : require(Permission.MANAGE_LAUNCHES)
alt нет права
  Ses --> S : AccessDeniedError
  S --> C : AccessDeniedError
  C --> V : 403 {error: "Недостаточно прав…"}
end

S -> L ** : LaunchWindow(start, end);\nLaunch(vehicle_type_id, pad_id,\npayload, orbit, window)
activate L
L -> L : require_text / require_int\n(непустые поля, начало < конец,\n1 мин ≤ окно ≤ 24 ч, не в прошлом)
alt данные некорректны
  L --> S : ValidationError
  S --> C : ValidationError
  C --> V : 400 {error: текст ошибки}
end
deactivate L

S -> PR : get(pad_id)
PR --> S : pad:LaunchPad
S -> PR : usage(pad_id)\n(COUNT активных подготовок,\nциклы и моточасы с ТО)
PR --> S : usage:PadUsage
S -> S : pad.ensure_can_accept(usage)
alt площадка на ТО / лимит подготовок исчерпан
  S --> C : BusinessRuleError
  C --> V : 400 {error: "Площадка … недоступна"}
end

S -> LR : add(launch)\n(параметризованный INSERT)
LR --> S : launch_id
S -> LR : log_status(launch_id, PLANNED,\nnow, staff_id)
S --> C : launch
deactivate S
C --> V : 201 {id, message}
V -> U : уведомление «Пуск №… зарегистрирован»,\nкарточка пуска
@enduml
