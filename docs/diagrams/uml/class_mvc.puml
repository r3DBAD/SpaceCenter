@startuml class_mvc
' Диаграмма классов: разделение на слои MVC и интерфейсы взаимодействия
skinparam DefaultFontName Arial
skinparam DefaultFontSize 11
skinparam BackgroundColor white
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide empty members
left to right direction

package "View  (lcc/view)" as V #E3F2FD {
  class "VueApp (app.js)" as VueApp <<Vue 3>> {
    +token: string
    +me, launches, card, report
    +login() / logout()
    +api(method, url, body)
    +post(url, body)
    +openCard(id) / register()
    +refuel() / weather()
    +buildReport() / downloadCsv()
  }
  class "index.html" as Html <<template>> {
    вкладки: Пуски, Новый пуск, Топливо,
    Метео, Телеметрия, Площадки,
    Персонал, Отчёты
  }
  class CsvExporter {
    +file_name(report): str
    +to_text(report): str
    -_safe_cell(value): str
  }
  VueApp *-- Html
}

package "Controller  (lcc/controller)" as C #FFF8E1 {
  class WebApi {
    -_sessions: dict[token, Session]
    -_routes: list[(method, regex, action)]
    +handle(method, url, headers, body): Response
    -_session(headers): Session
    -_static(name): Response
    +login() / me() / reference()
    +launches() / card() / register()
    +advance() / postpone() / cancel() / result()
    +refuel() / weather() / incident()
    +staff() / add_pad() / open_maintenance()
    +report() / report_csv()
  }
  class Response <<dataclass>> {
    +status: int
    +body: bytes
    +content_type: str
  }
  class "_Handler" as Handler <<http.server>> {
    +do_GET() / do_POST()
  }
  Handler --> WebApi : handle()
  WebApi ..> Response : создаёт
}

package "Model  (lcc/model)" as M #E8F5E9 {
  class Services <<facade>> {
    +auth: AuthService
    +staff: StaffService
    +reference: ReferenceService
    +pads: PadService
    +launches: LaunchService
    +fuel: FuelService
    +weather: WeatherService
    +telemetry: TelemetryService
    +reports: ReportService
  }
  class Session {
    +staff: Staff
    +can(p: Permission): bool
    +require(*p: Permission)
  }
  class "LaunchService" as LS {
    +register_launch(...): Launch
    +advance_stage(session, id): LaunchStatus
    +postpone(...): Postponement
    +cancel(...) / record_result(...)
    +launch_card(session, id): LaunchCard
  }
  class ReportService {
    +available(): list
    +build(session, key, period): ReportTable
  }
  class ReportTable <<DTO>> {
    +title, period, columns, rows, notes
  }
  class LaunchCard <<DTO>>
  class Repositories {
    +staff, vehicle_types, pads, launches
    +fuel, weather, telemetry, journal
  }
  class Database {
    +execute(sql, params)
    +query(sql, params)
    +transaction()
  }
  Services *-- LS
  Services *-- ReportService
  LS ..> Repositories
  ReportService ..> Repositories
  ReportService ..> ReportTable : создаёт
  LS ..> LaunchCard : создаёт
  Repositories o-- Database
}

VueApp ..> Handler : HTTP: JSON API /api/*\n+ статические файлы
WebApi --> Services : вызов сценариев
WebApi --> Session : токен → сессия
WebApi ..> CsvExporter : to_text()
CsvExporter ..> ReportTable : читает

@enduml
