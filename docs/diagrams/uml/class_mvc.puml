@startuml class_mvc
' Диаграмма классов: разделение на слои MVC и интерфейсы взаимодействия
skinparam DefaultFontName Arial
skinparam DefaultFontSize 11
skinparam BackgroundColor white
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
hide empty members
left to right direction

package "View  (lcc.view)" as V #E3F2FD {
  interface View <<interface>> {
    +show_title(text)
    +show_message(text)
    +show_error(text)
    +show_table(title, columns, rows, notes)
    +choose(title, options): str
    +ask_text / ask_int / ask_float
    +ask_date / ask_datetime / ask_password
    +confirm(question): bool
  }
  class ConsoleView {
    -_input: Callable
    -_print: Callable
    +show_table(...)
    -_ask(label, parse, default)
  }
  class CsvExporter {
    -_dir: Path
    +export(report: ReportTable): Path
    -_safe_cell(value): str
  }
  ConsoleView ..|> View
}

package "Controller  (lcc.controller)" as C #FFF8E1 {
  class AppController {
    +MAX_LOGIN_ATTEMPTS = 3
    +login(): Session
    +build_menu(session): list[MenuItem]
    +run()
  }
  class MenuItem <<dataclass>> {
    +title: str
    +permission: Permission
    +action: Callable
  }
  class BaseController {
    #view: View
    #services: Services
    #session: Session
    +safe(action): T | None
    +pick_launch(statuses): int
  }
  class LaunchController {
    +show_schedule() / show_card()
    +register() / advance()
    +postpone() / cancel()
    +record_result()
  }
  class FuelController {
    +receive_batch() / list_batches()
    +refuel()
  }
  class WeatherController {
    +record()
  }
  class TelemetryController {
    +add_channel() / register_incident()
  }
  class PadController {
    +add_pad() / open_maintenance()
    +close_maintenance()
  }
  class StaffController {
    +add_staff() / deactivate()
  }
  class ReportController {
    -_exporter: CsvExporter
    +run()
  }
  LaunchController --|> BaseController
  FuelController --|> BaseController
  WeatherController --|> BaseController
  TelemetryController --|> BaseController
  PadController --|> BaseController
  StaffController --|> BaseController
  ReportController --|> BaseController
  AppController *-- "1..*" MenuItem
  AppController ..> BaseController : создаёт
}

package "Model  (lcc.model)" as M #E8F5E9 {
  class Services <<facade>> {
    +auth: AuthService
    +staff: StaffService
    +reference: ReferenceService
    +pads: PadService
    +launches: LaunchService
    +fuel: FuelService
    +weather: WeatherService
    +telemetry: TelemetryService
    +reports: ReportService
  }
  class Session {
    +staff: Staff
    +can(p: Permission): bool
    +require(*p: Permission)
  }
  class "LaunchService" as LS {
    +register_launch(...): Launch
    +advance_stage(session, id): LaunchStatus
    +postpone(...): Postponement
    +cancel(...) / record_result(...)
    +launch_card(session, id): LaunchCard
  }
  class ReportService {
    +available(): list
    +build(session, key, period): ReportTable
  }
  class ReportTable <<DTO>> {
    +title, period, columns, rows, notes
  }
  class LaunchCard <<DTO>>
  class Repositories {
    +staff, vehicle_types, pads, launches
    +fuel, weather, telemetry, journal
  }
  class Database {
    +execute(sql, params)
    +query(sql, params)
    +transaction()
  }
  Services *-- LS
  Services *-- ReportService
  LS ..> Repositories
  ReportService ..> Repositories
  ReportService ..> ReportTable : создаёт
  LS ..> LaunchCard : создаёт
  Repositories o-- Database
}

BaseController --> View : вывод / ввод
BaseController --> Services : вызов сценариев
BaseController --> Session
AppController --> View
AppController --> Services
ReportController --> CsvExporter
CsvExporter ..> ReportTable : читает

note bottom of M
  Model не импортирует View и Controller.
  Проверка прав (Session.require), валидация
  и бизнес-правила выполняются только здесь.
end note
note bottom of V
  View не обращается к Model и БД:
  получает готовые строки/таблицы
  от Controller.
end note
@enduml
