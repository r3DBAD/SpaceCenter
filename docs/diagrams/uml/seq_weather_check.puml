@startuml seq_weather_check
' Сценарий S4 «Метеоконтроль и допуск к пуску / перенос»
skinparam DefaultFontName Arial
skinparam DefaultFontSize 12
skinparam BackgroundColor white
skinparam shadowing false
autonumber

actor "Метеоролог" as U
boundary ":Vue (app.js)" as V <<View>>
control ":WebApi" as C <<Controller>>
participant ":WeatherService" as S <<Model>>
participant ":WeatherLimits" as Lim <<Model>>
entity "obs:WeatherObservation" as O <<Model>>
entity "launch:Launch" as L <<Model>>
participant ":LaunchService" as LS <<Model>>
database ":WeatherRepository" as WR <<Model/DAO>>
database ":LaunchRepository" as LR <<Model/DAO>>
database ":JournalRepository" as JR <<Model/DAO>>

U -> V : вкладка «Метео»: пуск, ветер у земли / на высотах,\nt°, нижняя граница облачности, гроза
V -> C : POST /api/launches/{id}/weather (JSON)

C -> S : record_observation(session, launch_id,\nground, altitude, t°, cloud, storm)
activate S
S -> S : session.require(RECORD_WEATHER)
S -> O ** : WeatherObservation(...)
O -> O : _validate() (скорость ≥ 0,\nt° в физическом диапазоне)
S -> LR : get(launch_id)
LR --> S : launch
S -> Lim : violations(obs)
Lim --> S : список нарушений
S -> WR : add(obs)

deactivate S
alt нарушений нет
  S --> C : WeatherDecision(allowed=True)
  C --> V : 200 {allowed: true}
  V -> U : «Допуск разрешён»
else есть нарушения
  S --> C : WeatherDecision(allowed=False, reasons)
  C --> V : 200 {allowed: false, reasons}
  V -> U : «Пуск по метео запрещён» + причины,\nформа переноса
  U -> V : новое стартовое окно, «Перенести»
  V -> C : POST /api/launches/{id}/postpone\n{reason: weather, new_start, new_end}
  C -> LS : postpone(session, launch_id, WEATHER,\nstart, end, reasons)
  activate LS
  LS -> LS : session.require(POSTPONE_LAUNCH)
  LS -> LR : get(launch_id)
  LR --> LS : launch
  LS -> L : postpone(window, reason, ...)
  L -> L : проверка: статус не финальный,\nновое окно позже старого
  L --> LS : Postponement
  LS -> LR : update(launch)
  LS -> JR : add_postponement(postponement)
  LS --> C : postponement
  deactivate LS
  C --> V : 200 {message: "Пуск перенесён: …"}
end
@enduml
